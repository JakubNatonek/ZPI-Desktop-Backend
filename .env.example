# Database Configuration
# IMPORTANT: Update these credentials with your actual database connection info
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zpi_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_MAINTENANCE_DB=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zpi_db
AUTO_CREATE_DATABASE=true
DB_INIT_MAX_RETRIES=5
DB_INIT_RETRY_DELAY=2

# JWT Configuration
# IMPORTANT: Change JWT_SECRET_KEY to a secure random string in production
JWT_SECRET_KEY=qwe123asdzxcnmhjsd4rfvcxs1902342
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Configuration
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# CORS Configuration
# Update with your frontend URLs
CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100,http://localhost:4200,http://127.0.0.1:4200

# For DB auto creation
AUTO_CREATE_DATABASE=true
DB_INIT_MAX_RETRIES=5
DB_INIT_RETRY_DELAY=2
